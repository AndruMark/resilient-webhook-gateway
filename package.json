{
  "name": "resilient-webhook-gateway",
  "version": "1.0.0",
  "description": "Enterprise-grade resilient webhook ingestion and dispatch gateway",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/persistence/postgres/migrate.ts"
  },
  "keywords": [
    "webhooks",
    "cloudevents",
    "resilience",
    "transactional-outbox",
    "hexagonal-architecture"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.12.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.12.0",
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  }
}