# Application Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL) - Note the 5433 host port
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/webhook_gateway

# Redis
REDIS_URL=redis://localhost:6379

# Cryptography / Security
HMAC_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars